{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "manolitouy.com"
        }
      ],
      "destination": "https://project-manolito-web-production.up.railway.app/api/:path*"
    },
    {
      "source": "/assets/img/:path*",
      "has": [
        {
          "type": "host",
          "value": "manolitouy.com"
        }
      ],
      "destination": "https://project-manolito-web-production.up.railway.app/assets/img/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.manolitouy.com"
        }
      ],
      "destination": "https://project-manolito-web-production.up.railway.app/api/:path*"
    },
    {
      "source": "/assets/img/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.manolitouy.com"
        }
      ],
      "destination": "https://project-manolito-web-production.up.railway.app/assets/img/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://project-manolito-web-staging.up.railway.app/api/:path*"
    },
    {
      "source": "/assets/img/:path*",
      "destination": "https://project-manolito-web-staging.up.railway.app/assets/img/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
