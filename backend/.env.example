PORT=3000
# Cantidad de proxies delante del server (el del hosting, normalmente 1). Vacío = ninguno
TRUST_PROXY=
# development en tu máquina; en producción no se setea
# NODE_ENV=development
BASE_URL=http://localhost:3000
# Postgres. En desarrollo: `docker compose up -d` en la raíz del repo.
# En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} (variable de referencia al servicio de Postgres)
DATABASE_URL=postgres://manolito:manolito@127.0.0.1:5434/manolito
# Solo si se usa la URL pública de la base (con SSL): DATABASE_SSL=true

# Cuenta de admin: se ingresa con este email y contraseña en /login.html. También recibe el aviso de cada pedido nuevo.
# En producción la contraseña necesita 16 caracteres o más, si no el server no arranca
ADMIN_PASSWORD=

# Mails (Resend). Sin clave, los mails se muestran en consola.
RESEND_API_KEY=
MAIL_FROM=Manolito <pedidos@tudominio.com>
ADMIN_EMAIL=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Texto que recibe el cliente para pagar por transferencia / Abitab / Prex
PAGO_INSTRUCCIONES=
