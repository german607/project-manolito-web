PORT=3000
# Cantidad de proxies delante del server. Railway solo: 1. Vercel → Railway: 2 (verificalo en /api/admin/diagnostico). Vacío = ninguno
TRUST_PROXY=
# development en tu máquina; en producción no se setea
# NODE_ENV=development
# Dominio público de la web (Mercado Pago vuelve acá y manda los avisos de pago). Con Vercel: el dominio de Vercel
BASE_URL=http://localhost:3000
# Si el frontend está en Vercel: quien entre al dominio de Railway es redirigido acá
# FRONTEND_URL=https://manolito.vercel.app
# Postgres. En desarrollo: `docker compose up -d` en la raíz del repo.
# En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} (variable de referencia al servicio de Postgres)
DATABASE_URL=postgres://manolito:manolito@127.0.0.1:5434/manolito
# Solo si se usa la URL pública de la base (con SSL): DATABASE_SSL=true

# Cuenta de admin: se ingresa con este email y contraseña en /login.html. También recibe el aviso de cada pedido nuevo.
# En producción la contraseña necesita 16 caracteres o más, si no el server no arranca
ADMIN_PASSWORD=

# Imágenes del sitio en el bucket de Railway. Sin S3_BUCKET se sirven del disco (desarrollo).
# En Railway, como referencias al bucket: S3_BUCKET=${{Bucket.BUCKET}}, S3_ENDPOINT=${{Bucket.ENDPOINT}}, etc.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Carpeta del bucket donde están boxes/, marca/, etc. (por defecto assets/img/)
# S3_PREFIJO=assets/img/
# Solo si la pestaña Credentials del bucket dice path-style:
# S3_PATH_STYLE=true

# Mails (Resend). Sin clave, los mails se muestran en consola.
RESEND_API_KEY=
MAIL_FROM=Manolito <pedidos@tudominio.com>
ADMIN_EMAIL=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Texto que recibe el cliente para pagar por transferencia / Abitab / Prex
PAGO_INSTRUCCIONES=
